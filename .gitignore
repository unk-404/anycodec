# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
/.atom/
/.buildlog/
.history
/.svn/
/migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
/.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
#
# The root `pubspec.lock` IS committed, and that is the whole point of the
# workspace: one lock pins every member to the same versions. A *package* must
# not pin its consumers, which is why the members have no lock of their own —
# pub enforces that for us (a workspace member with a `pubspec.lock` is an error).
**/doc/api/
/.dart_tool/
/packages/*/.dart_tool/
.flutter-plugins-dependencies
/build/
/packages/*/build/
/coverage/
/packages/*/coverage/

# Build output of the one Rust artifact.
/packages/*/rust/target/

# Example apps are applications, not libraries, but their locks are noise here.
/packages/*/example/pubspec.lock

/.vscode/
/.agents/

# Root-anchored on purpose. In gitignore semantics an unanchored directory
# pattern matches at ANY depth, so `build/` would also swallow a hypothetical
# `lib/src/build/` - and the deletion is silent, nothing reports it. The same
# mistake in `.pubignore` once shipped a package that compiled for nobody.
# Keep every directory pattern here rooted with a leading `/`.