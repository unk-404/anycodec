# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
/.atom/
/.buildlog/
.history
/.svn/
/migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
/.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
/.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

/.vscode/
/.agents/

# Root-anchored on purpose. In gitignore semantics an unanchored directory
# pattern matches at ANY depth, so `build/` would also swallow a hypothetical
# `lib/src/build/` - and the deletion is silent, nothing reports it. The same
# mistake in `.pubignore` once shipped a package that compiled for nobody.
# Keep every directory pattern here rooted with a leading `/`.